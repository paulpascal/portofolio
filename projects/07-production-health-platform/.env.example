# CouchDB (offline-first collection source)
COUCHDB_USER=admin
COUCHDB_PASSWORD=password
COUCHDB_DB=medic

# Warehouse (Postgres locally; a managed warehouse in production)
WAREHOUSE_USER=wh
WAREHOUSE_PASSWORD=wh
WAREHOUSE_DB=warehouse

# ODK / Kobo (optional alternative collection source)
FORMS_PROVIDER=kobo
FORMS_BASE_URL=https://kf.kobotoolbox.org
FORMS_TOKEN=
FORMS_ASSET_ID=

# Ingestion
INGEST_BATCH=200
